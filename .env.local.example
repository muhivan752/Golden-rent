# ═══════════════════════════════════════════
# Supabase Configuration
# ═══════════════════════════════════════════
# Dapatkan dari: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
#
# 1. Buat akun di supabase.com
# 2. Buat project baru (region: Singapore)
# 3. Buka Settings → API
# 4. Copy URL dan anon key ke sini
# 5. Jalankan migration.sql di SQL Editor

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key (untuk setup admin tanpa konfirmasi email)
# Dapatkan dari: Settings → API → service_role (secret)
# PENTING: Jangan expose ke client/browser!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
